# Copy to backend/.env and adjust. Never commit the real .env.

APP_NAME=HolidayLandmarks API
APP_VERSION=0.1.0
ENVIRONMENT=local

# Local Postgres (same server as PycharmProjects/fastApiProject, port 5433).
DATABASE_URL=postgresql+psycopg2://postgres:root@localhost:5433/holidaylandmark

# Comma-separated list of allowed browser origins.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Added in a later phase (agent + LLM work).
# ANTHROPIC_API_KEY=
